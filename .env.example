# ---------------------------------------------------------------------------
# Copy to .env. NOTHING here reaches the browser bundle — the API key is
# server-side only, by design and by the vendor licence.
# ---------------------------------------------------------------------------

NODE_ENV=development
# Deliberately not PORT: dev harnesses inject PORT for Vite.
API_PORT=8000

# --- Quant Data ------------------------------------------------------------
# Leave EMPTY to run MockQuantDataClient (no API spend, full UI).
# Set it to go live — the poller switches over on restart, nothing else changes.
QD_API_KEY=
QD_BASE_URL=https://api.quantdata.us/v1
# Vendor plan limit. The whole poller shares this single bucket.
QD_RATE_LIMIT_PER_MIN=240

# --- Poll cadence per tier (ms) --------------------------------------------
# One ticker costs ~22 req/min at these values -> ~10 concurrent tickers.
TIER_T0_MS=4000
TIER_T1_MS=20000
TIER_T2_MS=90000
TIER_T3_MS=300000
TIER_T4_MS=3600000
SUBSCRIPTION_GRACE_MS=60000

TICKER_ALLOWLIST=SPY,SPX,QQQ,NDX,IWM,GLD,AAPL,NVDA,TSLA,MSFT,META,AMD

# Retail-standard assumption (dealers short calls / long puts). It is an
# ASSUMPTION — flip it if the vendor's exposure sign convention is the other one.
DEALER_SIGN_CONVENTION=dealer-short-calls

# --- Single-user auth gate -------------------------------------------------
AUTH_EMAIL=demo@quantam.io
AUTH_NAME=Lưu Uy Danh

# Generate with: npm run hash-password -- "your password"
# While unset, AUTH_DEV_PASSWORD is used instead (dev only).
AUTH_PASSWORD_HASH=
AUTH_DEV_PASSWORD=quantam123

# REQUIRED in production. Unset in dev -> a new secret per boot, so every
# restart logs you out. Any random 32+ byte hex string works.
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
SESSION_TTL_HOURS=12
